# Copy to .env and fill in. NEXT_PUBLIC_* values are exposed in the client
# bundle by design — never put a real secret behind that prefix.

# EmailJS (contact form) — browser-side, safe to expose.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Sentry error tracking.
# DSN is public (client-side), like the EmailJS keys.
NEXT_PUBLIC_SENTRY_DSN=
# Used only at build time for source-map upload. SENTRY_AUTH_TOKEN is a SECRET —
# set it in Vercel's env vars, never commit it. org/project are your slugs.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
